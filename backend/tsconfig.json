{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node"],
     // --- 추가할 부분 시작 ---
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
    // --- 추가할 부분 끝 ---
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
